  "defaults": {
    "delivery_mode": "documentary",
    "personality": "documentary_host",
    "voice": "rohan",
    "language": "hi",
    "model": "sonic-3.6",
    "cache_enabled": true,
    "force_regenerate": false,
    "volume": 1,
    "emotion_tags_enabled": false
  },
  "credit_policy": {
    "analysis_calls": 0,
    "cache_enabled": true,
    "cache_key_fields": [
      "text",
      "voice_id",
      "language",
      "emotion",
      "model",
      "sample_rate"
    ],
    "regenerate_only_on_force_or_cache_miss": true,
    "avoid_sentence_level_requests": true
  },
  "ssml": {
    "enabled": true,
    "speed_tags": true,
    "explicit_breaks": true,
    "emotion_tags_enabled": false,
    "emotion_language_allowlist": [
      "en"
    ],
    "max_explicit_breaks_per_script": 12,
    "minimum_break_ms": 350
  }
